# Copy this file to the EC2 deployment directory as .env and set real secrets there.
# Never commit the resulting .env file.
FACE_CLIENT_API_KEY=replace-with-a-long-random-client-key
FACE_ADMIN_API_KEY=replace-with-a-different-long-random-admin-key
FACE_DATABASE_URL=postgresql://attendance_user:change_me@localhost:5432/attendance_db
FACE_BUILD_VERSION=2.0-face-only
