# Copy this file to .env on EC2 and replace POSTGRES_PASSWORD.
# Use a URL-safe password: letters, digits, hyphen, underscore, or dot only.
POSTGRES_IMAGE=postgres:16
POSTGRES_USER=attendance_user
POSTGRES_PASSWORD=replace_with_a_long_random_url_safe_password
POSTGRES_DB=attendance_db
# A DNS A record for this hostname must point to the EC2 Elastic IP before the
# production stack starts. Caddy will obtain the public HTTPS certificate.
SERVER_NAME=attendance.example.edu.vn
CADDY_EMAIL=admin@example.edu.vn
HUCE_STUDENT_DB=huce_student_db
HUCE_LECTURER_DB=huce_lecturer_db
HUST_STUDENT_DB=hust_student_db
HUST_LECTURER_DB=hust_lecturer_db
# Leave empty for the native app. Set an explicit comma-separated allowlist
# only if a browser frontend is deployed.
CORS_ORIGIN=
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_TTL_SECONDS=28800
DATABASE_POOL_MAX=20

# Face Auth secrets stay on EC2. The APK never receives these keys.
FACE_CLIENT_API_KEY=replace_with_a_long_random_client_key
FACE_ADMIN_API_KEY=replace_with_a_different_long_random_admin_key
FACE_BUILD_VERSION=2.1-integrated

# Leave disabled until every student has an SFace template and an Android
# Keystore device key enrolled through the trusted enrollment flow. The old
# ArcFace flow remains active while this is false.
MOBILE_FACE_AUTH_ENABLED=false
MOBILE_FACE_MODEL_ID=opencv_sface_2021dec_v1

# Demo only: link MSSV 1389570 to an identity already enrolled in PostgreSQL FaceIdentity.
DEMO_STUDENT_FACE_IDENTITY=person_A
ATTENDANCE_REQUIRE_BLE=true
# Demo only: use one registered BLE beacon for sessions in every scheduled room.
# Leave empty when each classroom has its own beacon.
BLE_DEMO_ROOM_ID=
# JSON array of ESP32-C6 devices: deviceId (8 hex), beaconId, roomId, keyHex
# (32 hex). Keep real keys only in infra/.env on the server. The AES key must
# match the firmware flashed on each device.
BLE_C6_DEVICES_JSON=
