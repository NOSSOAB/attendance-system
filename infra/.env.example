# Copy this file to .env on EC2 and replace POSTGRES_PASSWORD.
# Use a URL-safe password: letters, digits, hyphen, underscore, or dot only.
POSTGRES_IMAGE=postgres:16
POSTGRES_USER=attendance_user
POSTGRES_PASSWORD=replace_with_a_long_random_url_safe_password
POSTGRES_DB=attendance_db
HUCE_STUDENT_DB=huce_student_db
HUCE_LECTURER_DB=huce_lecturer_db
HUST_STUDENT_DB=hust_student_db
HUST_LECTURER_DB=hust_lecturer_db
# Leave empty for the native app. Set an explicit comma-separated allowlist
# only if a browser frontend is deployed.
CORS_ORIGIN=
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_TTL_SECONDS=28800
DATABASE_POOL_MAX=20

# Face Auth secrets stay on EC2. The APK never receives these keys.
FACE_CLIENT_API_KEY=replace_with_a_long_random_client_key
FACE_ADMIN_API_KEY=replace_with_a_different_long_random_admin_key
FACE_BUILD_VERSION=2.1-integrated

# Demo only: link MSSV 1389570 to an identity already enrolled in PostgreSQL FaceIdentity.
DEMO_STUDENT_FACE_IDENTITY=person_A
